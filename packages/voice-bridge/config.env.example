# HomeHub voice bridge settings. install.sh copies this to
# ~/.config/homehub-voice/config.env. Restart after a change:
#   systemctl --user restart homehub-voice

# HomeHub's backend. On the same computer as HomeHub, keep localhost.
HOMEHUB_URL=http://localhost:3000

# A file holding INTERNAL_API_KEY from HomeHub's .env. Keep it private (chmod 600).
HOMEHUB_INTERNAL_KEY_FILE=~/.config/homehub-voice/internal-key

# Speakers are found on the network automatically. To add one by address,
# list it here as host[:port], and add |<encryption key> if it has one.
# Separate several with spaces.
SPEAKERS=
DISCOVER=true

# Speech recognition model and language. base.en is English only and fastest.
WHISPER_MODEL=base.en
LANGUAGE=en

# Add Cantonese with LANGUAGES=en yue, then run install.sh again to download its
# models. Each command is then heard in either language, and answered in it.
# Cantonese commands need Cantonese nicknames on devices (Settings → Devices).
LANGUAGES=en

# Spoken replies.
PIPER_VOICE=~/.local/share/homehub-voice/en_US-ljspeech-medium.onnx
# Speakers fetch replies from this port on this computer.
REPLY_PORT=39500
