 	"github.com/pion/rtp"
 )
 
+// backchannelCodecs is what the camera's speaker takes: the codec the camera sends, and,
+// for a camera that sends raw PCM, G.711 too, converted to PCM on the way. A browser can't
+// send raw PCM over WebRTC, but every browser sends G.711.
+func backchannelCodecs(acodec *core.Codec) []*core.Codec {
+	codecs := []*core.Codec{acodec.Clone()}
+	if acodec.Name == core.CodecPCML {
+		codecs = append(codecs,
+			&core.Codec{Name: core.CodecPCMA, ClockRate: 8000},
+			&core.Codec{Name: core.CodecPCMU, ClockRate: 8000},
+		)
+	}
+	return codecs
+}
+
+// toCameraPCM converts G.711 to the camera's PCM and cuts it into the camera's frames,
+// whatever size the packets arrive in. Each frame is passed to write.
+func toCameraPCM(src *core.Codec, sampleRate uint32, channels uint8, samplesPerFrame uint32, write func([]byte)) func([]byte) {
+	if channels == 0 {
+		channels = 1
+	}
+	dst := &core.Codec{Name: core.CodecPCML, ClockRate: sampleRate, Channels: channels}
+	transcode := pcm.Transcode(dst, src)
+	size := int(samplesPerFrame) * 2 * int(channels)
+	var buf []byte
+	return func(payload []byte) {
+		buf = append(buf, transcode(payload)...)
+		for len(buf) >= size {
+			write(buf[:size])
+			buf = buf[size:]
+		}
+	}
+}
