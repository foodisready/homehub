diff --git a/pkg/wyze/backchannel_test.go b/pkg/wyze/backchannel_test.go
new file mode 100644
index 0000000..c5a5711
--- /dev/null
+++ b/pkg/wyze/backchannel_test.go
@@ -0,0 +1,61 @@
+package wyze
+
+import (
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/pcm"
+)
+
+func TestBackchannelCodecsAddG711ForPCM(t *testing.T) {
+	got := backchannelCodecs(&core.Codec{Name: core.CodecPCML, ClockRate: 8000, Channels: 1})
+	if len(got) != 3 || got[0].Name != core.CodecPCML || got[1].Name != core.CodecPCMA || got[2].Name != core.CodecPCMU {
+		t.Fatalf("codecs = %v", got)
+	}
+	if got := backchannelCodecs(&core.Codec{Name: core.CodecPCMA, ClockRate: 8000}); len(got) != 1 {
+		t.Fatalf("a G.711 camera keeps its own codec only, got %v", got)
+	}
+}
+
+func TestToCameraPCMMakesWholeFrames(t *testing.T) {
+	var frames [][]byte
+	convert := toCameraPCM(&core.Codec{Name: core.CodecPCMA, ClockRate: 8000}, 8000, 1, 160, func(b []byte) {
+		frames = append(frames, append([]byte(nil), b...))
+	})
+	// A browser's 20 ms of A-law is 160 bytes; three and a half packets make seven frames of 320 bytes.
+	alaw := make([]byte, 160)
+	for i := range alaw {
+		alaw[i] = pcm.PCMtoPCMA(int16(i * 100))
+	}
+	convert(alaw)
+	convert(alaw)
+	convert(alaw)
+	convert(alaw[:80])
+	if len(frames) != 3 {
+		t.Fatalf("frames = %d, want 3 (the half packet waits)", len(frames))
+	}
+	for _, f := range frames {
+		if len(f) != 320 {
+			t.Fatalf("frame is %d bytes, want 320", len(f))
+		}
+	}
+	// Little-endian PCM, close to what went in.
+	s := int16(frames[0][201])<<8 | int16(frames[0][200])
+	if d := int(s) - 100*100; d < -400 || d > 400 {
+		t.Fatalf("sample 100 = %d, want about %d", s, 100*100)
+	}
+	convert(alaw[:80])
+	if len(frames) != 4 {
+		t.Fatalf("frames = %d, want 4 once the second half arrives", len(frames))
+	}
+}
+
+func TestToCameraPCMResamplesForA16kCamera(t *testing.T) {
+	var n int
+	convert := toCameraPCM(&core.Codec{Name: core.CodecPCMU, ClockRate: 8000}, 16000, 1, 320, func(b []byte) { n += len(b) })
+	convert(make([]byte, 160)) // 20 ms
+	convert(make([]byte, 160))
+	if n != 1280 {
+		t.Fatalf("got %d bytes, want 1280 (40 ms in, two frames of 20 ms at 16 kHz out)", n)
+	}
+}
