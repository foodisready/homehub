new file mode 100644
index 0000000..1743287
--- /dev/null
+++ b/internal/wyze/ptz.go
@@ -0,0 +1,157 @@
+package wyze
+
+import (
+	"encoding/hex"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/AlexxIT/go2rtc/internal/api"
+	"github.com/AlexxIT/go2rtc/internal/streams"
+	"github.com/AlexxIT/go2rtc/pkg/wyze"
+)
+
+// Pan and tilt for Wyze Pan cameras.
+//
+//	GET  api/wyze/ptz?src=<stream>                     -> {"position":{"horizontal":h,"vertical":v},"motion_tracking":bool}
+//	POST api/wyze/ptz?src=<stream>&action=left|right|up|down[&speed=1-9]   start turning
+//	POST api/wyze/ptz?src=<stream>&action=stop
+//	POST api/wyze/ptz?src=<stream>&action=goto&h=<0-360>&v=<0-180>
+//	POST api/wyze/ptz?src=<stream>&action=tracking&on=true|false
+//
+// On a Pan v3, left/right/up/down start the lens turning, and it keeps
+// turning until stop, another move, or the end of its range: a caller
+// holding an arrow sends stop when it's let go. POST answers with the
+// camera's reply, in hex ("01" when it accepts).
+//
+// Commands use the stream's connection when someone is watching, or a
+// connection kept open for commands for a short while.
+
+var errNoStream = errors.New("wyze: no such Wyze stream")
+
+// sourceFor finds the wyze:// source behind a stream name; tests replace it.
+var sourceFor = func(name string) (string, error) {
+	stream := streams.Get(name)
+	if stream == nil {
+		return "", errNoStream
+	}
+	for _, src := range stream.Sources() {
+		if strings.HasPrefix(src, "wyze://") {
+			return src, nil
+		}
+	}
+	return "", errNoStream
+}
+
+var withCamera = wyze.WithCamera
+
+type ptzState struct {
+	Position       *wyze.Position `json:"position,omitempty"`
+	MotionTracking *bool          `json:"motion_tracking,omitempty"`
+}
+
+func apiPTZ(w http.ResponseWriter, r *http.Request) {
+	query := r.URL.Query()
+	src, err := sourceFor(query.Get("src"))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+
+	switch r.Method {
+	case "GET":
+		var state ptzState
+		err = withCamera(src, func(c *wyze.Client) error {
+			pos, err := c.Position()
+			if err != nil {
+				return err
+			}
+			state.Position = &pos
+			// Older Pans may not answer this; the position is still worth having.
+			if on, err := c.MotionTracking(); err == nil {
+				state.MotionTracking = &on
+			}
+			return nil
+		})
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadGateway)
+			return
+		}
+		api.ResponseJSON(w, state)
+
+	case "POST":
+		run, status, msg := ptzAction(query)
+		if run == nil {
+			http.Error(w, msg, status)
+			return
+		}
+		var reply []byte
+		err = withCamera(src, func(c *wyze.Client) error {
+			if err := run(c); err != nil {
+				return err
+			}
+			reply = c.LastReply()
+			return nil
+		})
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadGateway)
+			return
+		}
+		api.ResponseJSON(w, map[string]string{"camera_reply": hex.EncodeToString(reply)})
+
+	default:
+		http.Error(w, "", http.StatusMethodNotAllowed)
+	}
+}
+
+func ptzAction(query map[string][]string) (func(*wyze.Client) error, int, string) {
+	get := func(k string) string {
+		if v := query[k]; len(v) > 0 {
+			return v[0]
+		}
+		return ""
+	}
+
+	var speed byte
+	if s := get("speed"); s != "" {
+		n, err := strconv.Atoi(s)
+		if err != nil || n < 1 || n > 9 {
+			return nil, http.StatusBadRequest, "speed must be 1-9"
+		}
+		speed = byte(n)
+	}
+
+	move := func(pan, tilt byte) func(*wyze.Client) error {
+		return func(c *wyze.Client) error { return c.Move(pan, tilt, speed) }
+	}
+
+	switch get("action") {
+	case "left":
+		return move(wyze.PanLeft, wyze.TiltNone), 0, ""
+	case "right":
+		return move(wyze.PanRight, wyze.TiltNone), 0, ""
+	case "up":
+		return move(wyze.PanNone, wyze.TiltUp), 0, ""
+	case "down":
+		return move(wyze.PanNone, wyze.TiltDown), 0, ""
+	case "stop":
+		return move(wyze.PanNone, wyze.TiltNone), 0, ""
+	case "goto":
+		h, errH := strconv.Atoi(get("h"))
+		v, errV := strconv.Atoi(get("v"))
+		if errH != nil || errV != nil || h < 0 || h > 360 || v < 0 || v > 180 {
+			return nil, http.StatusBadRequest, "goto needs h (0-360) and v (0-180)"
+		}
+		pos := wyze.Position{Horizontal: uint16(h), Vertical: uint8(v)}
+		return func(c *wyze.Client) error { return c.SetPosition(pos) }, 0, ""
+	case "tracking":
+		on, err := strconv.ParseBool(get("on"))
+		if err != nil {
+			return nil, http.StatusBadRequest, "tracking needs on=true or on=false"
+		}
+		return func(c *wyze.Client) error { return c.SetMotionTracking(on) }, 0, ""
+	default:
+		return nil, http.StatusBadRequest, "action must be left, right, up, down, stop, goto or tracking"
+	}
+}
diff --git a/internal/wyze/ptz_test.go b/internal/wyze/ptz_test.go
new file mode 100644
index 0000000..b121364
--- /dev/null
+++ b/internal/wyze/ptz_test.go
@@ -0,0 +1,59 @@
+package wyze
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/wyze"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPTZAPI(t *testing.T) {
+	sourceFor = func(name string) (string, error) {
+		if name == "general" {
+			return "wyze://general", nil
+		}
+		return "", errNoStream
+	}
+	var ran []string
+	withCamera = func(src string, fn func(*wyze.Client) error) error {
+		ran = append(ran, src)
+		return errors.New("camera reached")
+	}
+
+	call := func(method, query string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		apiPTZ(w, httptest.NewRequest(method, "/api/wyze/ptz?"+query, nil))
+		return w
+	}
+
+	require.Equal(t, http.StatusNotFound, call("POST", "src=nope&action=left").Code)
+	require.Equal(t, http.StatusBadRequest, call("POST", "src=general&action=spin").Code)
+	require.Equal(t, http.StatusBadRequest, call("POST", "src=general&action=left&speed=12").Code)
+	require.Equal(t, http.StatusBadRequest, call("POST", "src=general&action=goto&h=400&v=10").Code)
+	require.Equal(t, http.StatusBadRequest, call("POST", "src=general&action=tracking&on=maybe").Code)
+	require.Equal(t, http.StatusMethodNotAllowed, call("DELETE", "src=general").Code)
+	require.Empty(t, ran, "nothing reaches the camera until the request is valid")
+
+	w := call("POST", "src=general&action=left")
+	require.Equal(t, http.StatusBadGateway, w.Code)
+	require.Contains(t, w.Body.String(), "camera reached")
+	require.Equal(t, []string{"wyze://general"}, ran)
+
+	withCamera = func(src string, fn func(*wyze.Client) error) error { return nil }
+	for _, q := range []string{"action=left", "action=down&speed=3", "action=goto&h=90&v=10", "action=tracking&on=false"} {
+		require.Equal(t, http.StatusOK, call("POST", "src=general&"+q).Code, q)
+	}
+}
+
+func TestPTZActionsBuildTheRightMove(t *testing.T) {
+	for action, valid := range map[string]bool{"left": true, "right": true, "up": true, "down": true, "stop": true, "center": false, "": false} {
+		run, status, _ := ptzAction(map[string][]string{"action": {action}})
+		require.Equal(t, valid, run != nil, action)
+		if !valid {
+			require.Equal(t, http.StatusBadRequest, status)
+		}
+	}
+}
