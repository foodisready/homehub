# HomeHub settings. Everything in this file is optional.
#
# Without a .env, HomeHub:
#   - generates its own secrets in its data volume on first start,
#   - asks for an admin account the first time you open it in a browser,
#   - takes your home's location and time zone in Settings → Home.
#
# Set a value here only to change a default. Values set here win over the
# generated ones, so existing installs keep working unchanged.

# ── Optional features ─────────────────────────────────────────
# Wyze cameras: set to `cameras`, restart, then sign in to Wyze in HomeHub
# under Cameras. Tailscale container: `remote-access`. Separate several with
# commas, e.g. cameras,remote-access.
COMPOSE_PROFILES=

# The local AI model for Chat. llama3.2:3b needs about 3 GB of memory;
# llama3.2:1b suits a 4 GB Raspberry Pi; qwen2.5:7b reasons better with 8 GB.
OLLAMA_MODEL=llama3.2:3b

# Tailscale auth key, for the remote-access profile.
# Get one from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Shown by the QR code button, for example your
# https://<machine>.<tailnet>.ts.net address. If blank, the QR code uses the
# address the page was opened from.
HOMEHUB_REMOTE_URL=

# The name HomeHub answers to on your home network: http://<name>.local:4200.
# Blank means homehub. Change it if you run two HomeHubs, or set `off`.
HOMEHUB_LOCAL_NAME=

# Time zone for the containers' own logs. HomeHub's schedules use the one in
# Settings → Home.
TZ=

# ── Published images ───────────────────────────────────────────
# `docker compose -f docker-compose.yml pull` downloads
# <prefix>/homehub-backend:<tag> and the other HomeHub images from Docker
# Hub. Leave blank for the official images and latest version; set a tag
# (a commit, such as e597021) to stay on one version.
HOMEHUB_IMAGE_PREFIX=
HOMEHUB_TAG=

# ── Energy monitoring ─────────────────────────────────────────
# Cost per kWh in your local currency (for monthly estimates)
ENERGY_RATE_PER_KWH=0.15
# How often to poll HS110/KP115 plugs for energy data (seconds)
ENERGY_POLL_INTERVAL_SECONDS=60

# ── Instead of first-run setup ────────────────────────────────
# With ADMIN_PASSWORD set, HomeHub creates this admin on first start instead
# of asking in the browser. Ignored once any user exists.
ADMIN_USER=
ADMIN_PASSWORD=

# Settings → Home replaces these. Used only until a location and time zone
# are saved there.
LATITUDE=
LONGITUDE=
TIMEZONE=

# ── Your own secrets instead of generated ones ────────────────
# Leave blank to use the ones HomeHub generates (in the data volume's
# secrets folder). To set one, use `openssl rand -hex 32`.
JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_API_KEY=
# The AI assistant (MCP) secret. Settings → Integrations → AI assistant shows it.
MCP_SECRET=
WATCHTOWER_HTTP_API_TOKEN=
WYZE_BRIDGE_API_KEY=

# ── Development only (docker-compose.yml sets its own) ─────────
NODE_ENV=production
PORT=3000
DB_PATH=/data/db.sqlite
CORS_ORIGIN=http://localhost:4200
OLLAMA_URL=http://ollama:11434
MCP_PORT=3001
SCHEDULER_PORT=3002
BACKEND_URL=http://localhost:3000
SCHEDULER_URL=http://scheduler:3002
# Baked into images by scripts/release-images.sh; "dev" hides the Update card.
HOMEHUB_VERSION=dev
