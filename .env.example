# ── Backend ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Initial admin account (created on first run if no users exist)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-first-run

# SQLite database path (inside container, mapped to ./data volume)
DB_PATH=/data/db.sqlite

# Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:4200

# ── Location (for solar scheduling) ───────────────────────────
# Replace these with your own, or solar schedules run at San Francisco's times.
# Find your coordinates: https://www.latlong.net
LATITUDE=37.7749
LONGITUDE=-122.4194
TIMEZONE=America/Los_Angeles
# Set this to the same zone. Fixed-time schedules run in UTC without it.
TZ=America/Los_Angeles

# ── Ollama (Local LLM) ─────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# Model options for Raspberry Pi 5:
#   llama3.2:3b   — fast, ~2GB RAM, good tool calling (recommended)
#   qwen2.5:7b    — better reasoning, ~5GB RAM
OLLAMA_MODEL=llama3.2:3b

# ── MCP Server ─────────────────────────────────────────────────
MCP_PORT=3001
# Shared secret for MCP server Bearer token auth
MCP_SECRET=change-me-generate-with-openssl-rand-base64-32

# ── Scheduler ──────────────────────────────────────────────────
SCHEDULER_PORT=3002
BACKEND_URL=http://localhost:3000
SCHEDULER_URL=http://scheduler:3002
# Shared secret for backend ↔ scheduler internal calls
INTERNAL_API_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Tailscale (remote access) ──────────────────────────────────
# Get from: https://login.tailscale.com/admin/settings/keys
# Leave blank to skip the tailscale service (uses Docker profile: remote-access)
TS_AUTHKEY=

# ── Wyze cameras (optional) ───────────────────────────────────
# Runs docker-wyze-bridge, which HomeHub uses for live video, pausing
# cameras and motion snapshots. To turn it on, set both lines below,
# restart, then sign in to Wyze in HomeHub under Cameras.
#   COMPOSE_PROFILES=cameras
#   WYZE_BRIDGE_API_KEY=<run: openssl rand -hex 24>
# Separate several profiles with commas, e.g. cameras,remote-access.
# Your Wyze password is passed to the bridge, never stored by HomeHub.
COMPOSE_PROFILES=
WYZE_BRIDGE_API_KEY=

# ── Energy monitoring ─────────────────────────────────────────
# Cost per kWh in your local currency (for monthly estimates)
ENERGY_RATE_PER_KWH=0.15
# How often to poll HS110/KP115 plugs for energy data (seconds)
ENERGY_POLL_INTERVAL_SECONDS=60

# ── HomeHub self-update (Watchtower sidecar) ──────────────────
# Shared secret between Watchtower's HTTP API and the backend's
# POST /api/system/update. Generate once with:
#   openssl rand -hex 32
# Backend reads this same value to authenticate the forwarded
# request. Required when running via docker-compose; safe to
# leave blank for non-Docker dev (the Update card stays hidden).
WATCHTOWER_HTTP_API_TOKEN=

# ── Remote address ────────────────────────────────────────────
# Shown by the dashboard's QR code button, for example your
# https://<machine>.<tailnet>.ts.net address. If blank, the QR code
# uses the address the page was opened from.
HOMEHUB_REMOTE_URL=

# ── HomeHub release version (build-time) ──────────────────────
# Baked into the backend container so /api/system/version can
# report what's running. Typically set by CI from the git tag.
# Leave as "dev" for local builds — the Update card stays hidden.
HOMEHUB_VERSION=dev
