# ── Backend ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Initial admin account (created on first run if no users exist)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-first-run

# SQLite database path (inside container, mapped to ./data volume)
DB_PATH=/data/db.sqlite

# Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:4200

# ── Location (for solar scheduling) ───────────────────────────
# Find your coordinates: https://www.latlong.net
LATITUDE=37.7749
LONGITUDE=-122.4194
TIMEZONE=America/Los_Angeles

# ── Ollama (Local LLM) ─────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# Model options for Raspberry Pi 5:
#   llama3.2:3b   — fast, ~2GB RAM, good tool calling (recommended)
#   qwen2.5:7b    — better reasoning, ~5GB RAM
OLLAMA_MODEL=llama3.2:3b

# ── MCP Server ─────────────────────────────────────────────────
MCP_PORT=3001
# Shared secret for MCP server Bearer token auth
MCP_SECRET=change-me-generate-with-openssl-rand-base64-32

# ── Scheduler ──────────────────────────────────────────────────
SCHEDULER_PORT=3002
BACKEND_URL=http://localhost:3000
SCHEDULER_URL=http://scheduler:3002
# Shared secret for backend ↔ scheduler internal calls
INTERNAL_API_KEY=change-me-generate-with-openssl-rand-base64-32

# ── Tailscale (remote access) ──────────────────────────────────
# Get from: https://login.tailscale.com/admin/settings/keys
# Leave blank to skip the tailscale service (uses Docker profile: remote-access)
TS_AUTHKEY=

# ── Energy monitoring ─────────────────────────────────────────
# Cost per kWh in your local currency (for monthly estimates)
ENERGY_RATE_PER_KWH=0.15
# How often to poll HS110/KP115 plugs for energy data (seconds)
ENERGY_POLL_INTERVAL_SECONDS=60
